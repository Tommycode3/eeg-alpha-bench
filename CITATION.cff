    given-names: Tommaso
version: 0.1.0
date-released: "2026-10-30"
license: MIT
repository-code: "https://github.com/Tommycode3/eeg-alpha-bench"
keywords:
  - EEG
  - alpha rhythm
  - Berger effect
  - signal quality
  - neurotechnology
  - benchmark
